[paths]
# Imported titles are saved as <games>/<TITLE_ID>/.
games = "./games"
# Reserved for future game launching.
loader = "./vita2native"
# Guest filesystem root (ux0/, savedata/, system/, cache/, log.txt).
storage = "./storage"

