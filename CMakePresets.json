{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 19,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "arm-rel",
            "displayName": "32-bit ARM release (deploy artifact)",
            "description": "Cross build for armhf with zig. This is the binary that gets deployed to the devices.",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/cmake-arm-rel",
            "toolchainFile": "${sourceDir}/cmake/toolchains/zig-arm.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "VITA2NATIVE_HEADLESS": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON"
            }
        },
        {
            "name": "arm-debug",
            "displayName": "32-bit ARM debug",
            "description": "Cross build for armhf with zig and symbols suitable for gdb on the device.",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/cmake-arm",
            "toolchainFile": "${sourceDir}/cmake/toolchains/zig-arm.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "VITA2NATIVE_HEADLESS": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON"
            }
        },
        {
            "name": "arm-minsize",
            "displayName": "32-bit ARM minimum size (experiments)",
            "description": "LTO and stripped dynamic symbols. For size experiments only: crash backtraces lose names.",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/cmake-arm-minsize",
            "toolchainFile": "${sourceDir}/cmake/toolchains/zig-arm.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel",
                "VITA2NATIVE_HEADLESS": "ON",
                "VITA2NATIVE_NO_BACKTRACE_SYMBOLS": "ON",
                "CMAKE_C_FLAGS_MINSIZEREL": "-Os -DNDEBUG -flto",
                "CMAKE_CXX_FLAGS_MINSIZEREL": "-Os -DNDEBUG -flto",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON"
            }
        },
        {
            "name": "x64-syntax",
            "displayName": "64-bit x86 compile check",
            "description": "Full-source compile check and smoke-test build where a 32-bit ARM userland is not available. Cannot execute Vita code.",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/cmake-x64",
            "toolchainFile": "${sourceDir}/cmake/toolchains/zig-x64.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "VITA2NATIVE_HEADLESS": "ON",
                "VITA2NATIVE_ALLOW_64BIT": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "arm-rel",
            "hidden": false,
            "configurePreset": "arm-rel"
        },
        {
            "name": "arm-debug",
            "hidden": false,
            "configurePreset": "arm-debug"
        },
        {
            "name": "arm-minsize",
            "hidden": false,
            "configurePreset": "arm-minsize"
        },
        {
            "name": "x64-syntax",
            "hidden": false,
            "configurePreset": "x64-syntax"
        }
    ]
}
