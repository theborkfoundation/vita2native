{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 19,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "Linux-Debug",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Linux-Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON"
            }
        },
        {
            "name": "Linux-Release",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Linux-Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON"
            }
        },
        {
            "name": "Linux-Cross-Headless",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Linux-Cross-Headless",
            "toolchainFile": "${sourceDir}/cmake/toolchains/arm-linux-gnueabihf.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VITA2NATIVE_HEADLESS": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON"
            }
        },
        {
            "name": "Linux-Cross-MinSize",
            "hidden": false,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/Linux-Cross-MinSize",
            "toolchainFile": "${sourceDir}/cmake/toolchains/arm-linux-gnueabihf.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "MinSizeRel",
                "VITA2NATIVE_HEADLESS": "ON",
                "VITA2NATIVE_NO_BACKTRACE_SYMBOLS": "ON",
                "CMAKE_C_FLAGS_MINSIZEREL": "-Os -DNDEBUG -flto",
                "CMAKE_CXX_FLAGS_MINSIZEREL": "-Os -DNDEBUG -flto",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Linux-Debug",
            "hidden": false,
            "configurePreset": "Linux-Debug"
        },
        {
            "name": "Linux-Release",
            "hidden": false,
            "configurePreset": "Linux-Release"
        },
        {
            "name": "Linux-Cross-Headless",
            "hidden": false,
            "configurePreset": "Linux-Cross-Headless"
        },
        {
            "name": "Linux-Cross-MinSize",
            "hidden": false,
            "configurePreset": "Linux-Cross-MinSize"
        }
    ]
}
