{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 19, "patch": 0 },
    "configurePresets": [
        {
            "name": "arm64-cross",
            "displayName": "ARM64 Linux launcher (Zig cross-build)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/../../build/launcher-arm64-cross",
            "toolchainFile": "${sourceDir}/../../cmake/toolchains/zig-arm64.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_EXE_LINKER_FLAGS": "-s"
            }
        },
        {
            "name": "macos",
            "displayName": "macOS launcher (native)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/../../build/launcher-macos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "arm64-cross", "configurePreset": "arm64-cross" },
        { "name": "macos", "configurePreset": "macos" }
    ]
}
