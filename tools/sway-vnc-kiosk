#!/usr/bin/env python3
"""Sway VNC kiosk (640x480, GPU-composited) with installer and client runner.

Commands:
  install --user <name> [--no-auth]   install for <name> (must be run as root)
  serve                               run the compositor and VNC server (default)
  run <command> [args…]               run a Wayland client against the kiosk socket

The compositor is sway on the wlroots headless backend with the GLES2 renderer,
so clients render on the board's GPU (panfrost on an H618) instead of llvmpipe,
and wayvnc captures the composited output. Requires sway, wayvnc and a working
GL driver. Only the Python standard library is used.
"""

from __future__ import annotations

import argparse
import os
import pwd
import shutil
import signal
import socket
import stat
import subprocess
import sys
import time

SCRIPT_NAME = "sway-vnc-kiosk"
SERVICE_NAME = "sway-vnc-kiosk.service"

SOCKET = "wayland-kiosk"
PORT = 5901
WIDTH = 640
HEIGHT = 480
LOG_FILE = "/tmp/sway-vnc-kiosk.log"

UNIT_TEMPLATE = """[Unit]
Description=Sway VNC kiosk ({width}x{height}, GPU-composited)
After=dbus.service

[Service]
Type=simple
ExecStart=%h/.local/bin/{script} serve
Restart=always
RestartSec=2
StandardOutput=append:{log}
StandardError=append:{log}

[Install]
WantedBy=default.target
"""

SWAY_TEMPLATE = """# Generated by {script}. Kept across reinstalls.
xwayland disable
output * resolution {width}x{height}
output * bg #000000 solid_color
for_window [app_id=".*"] fullscreen enable
for_window [class=".*"] fullscreen enable
"""

WAYVNC_AUTH_TEMPLATE = """# Generated by {script}. Keep this file private: it references the TLS key.
address=0.0.0.0
port={port}
enable_auth=true
enable_pam=true
private_key_file={key}
certificate_file={cert}
"""

WAYVNC_OPEN_TEMPLATE = """# Generated by {script}. No authentication: any host that can reach the
# port gets the keyboard and pointer. Use install --user <name> to re-enable
# TLS and PAM authentication.
address=0.0.0.0
port={port}
"""


def log(msg: str) -> None:
    print(msg, flush=True)


def die(msg: str, code: int = 1) -> "NoReturn":  # noqa: F821
    print(f"error: {msg}", file=sys.stderr, flush=True)
    raise SystemExit(code)


def config_root(home: str | None = None) -> str:
    return os.environ.get("XDG_CONFIG_HOME") or os.path.join(
        home or os.path.expanduser("~"), ".config"
    )


def runtime_dir() -> str:
    return os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"


def kiosk_dir(home: str | None = None) -> str:
    return os.path.join(config_root(home), SCRIPT_NAME)


def ensure_tls(cert: str, key: str) -> None:
    cert_ok = os.path.exists(cert) and os.path.getsize(cert) > 0
    key_ok = os.path.exists(key) and os.path.getsize(key) > 0
    if cert_ok and key_ok:
        log(f"TLS key pair already present: {key}")
        return
    openssl = shutil.which("openssl")
    if not openssl:
        die("openssl not found; cannot generate TLS key pair")
    log(f"generating self-signed TLS key pair in {os.path.dirname(key)}")
    try:
        subprocess.run(
            [
                openssl, "req", "-x509", "-newkey", "rsa:2048", "-nodes",
                "-days", "3650",
                "-subj", f"/CN={socket.gethostname()}",
                "-keyout", key, "-out", cert,
            ],
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError:
        die("openssl failed to generate the TLS key pair")
    os.chmod(key, 0o600)
    os.chmod(cert, 0o644)


def write_if_missing(path: str, content: str, uid: int, gid: int) -> None:
    if os.path.exists(path):
        log(f"keeping existing {path}")
        return
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(content)
    os.chown(path, uid, gid)
    os.chmod(path, 0o644)
    log(f"wrote {path}")


def write_unit(path: str, uid: int, gid: int) -> None:
    content = UNIT_TEMPLATE.format(
        width=WIDTH, height=HEIGHT, script=SCRIPT_NAME, log=LOG_FILE
    )
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as fh:
            if fh.read() == content:
                log(f"unit unchanged: {path}")
                return
        backup = f"{path}.bak-{time.strftime('%Y%m%d%H%M%S')}"
        shutil.copyfile(path, backup)
        os.chown(backup, uid, gid)
        log(f"updating {path} (previous copy: {backup})")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(content)
    os.chown(path, uid, gid)
    os.chmod(path, 0o644)


def wait_for_user_manager(uid: int) -> str:
    runtime = f"/run/user/{uid}"
    bus = os.path.join(runtime, "bus")

    def up() -> bool:
        try:
            return stat.S_ISSOCK(os.stat(bus).st_mode)
        except OSError:
            return False

    for _ in range(50):
        if up():
            return runtime
        time.sleep(0.2)
    log(f"starting user manager for uid {uid}")
    subprocess.run(
        ["systemctl", "start", f"user@{uid}.service"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    for _ in range(50):
        if up():
            return runtime
        time.sleep(0.2)
    die(f"user manager for uid {uid} did not come up (is systemd-logind running?)")


def cmd_install(args: argparse.Namespace) -> None:
    if os.geteuid() != 0:
        die("install must be run as root (use sudo)")
    try:
        pw = pwd.getpwnam(args.user)
    except KeyError:
        die(f"no such user: {args.user}")
    home = pw.pw_dir
    if not home or not os.path.isdir(home):
        die(f"cannot resolve home directory for {args.user}")
    uid, gid = pw.pw_uid, pw.pw_gid
    runuser = shutil.which("runuser")
    if not runuser:
        die("runuser not found (util-linux is required)")
    for binary in ("sway", "wayvnc"):
        if not shutil.which(binary):
            die(f"{binary} not found; install it first (apt install sway wayvnc)")

    bin_dir = os.path.join(home, ".local", "bin")
    conf_dir = kiosk_dir(home)
    cert = os.path.join(conf_dir, "vnc-cert.pem")
    key = os.path.join(conf_dir, "vnc-key.pem")
    sway_conf = os.path.join(conf_dir, "sway.conf")
    vnc_conf = os.path.join(conf_dir, "wayvnc.conf")
    unit_dir = os.path.join(home, ".config", "systemd", "user")
    unit = os.path.join(unit_dir, SERVICE_NAME)
    dst = os.path.join(bin_dir, SCRIPT_NAME)

    log(f"installing for user {args.user} (uid {uid}, home {home})")

    for path, mode in ((bin_dir, 0o755), (conf_dir, 0o700), (unit_dir, 0o755)):
        os.makedirs(path, exist_ok=True)
        os.chown(path, uid, gid)
        os.chmod(path, mode)

    src = os.path.realpath(__file__)
    if os.path.realpath(dst) != src:
        shutil.copyfile(src, dst)
        os.chmod(dst, 0o755)
        os.chown(dst, uid, gid)
        log(f"installed {dst}")
    else:
        log(f"script already installed at {dst}")

    if args.no_auth:
        log("WARNING: no authentication; the port is open to anyone who can reach it")
    else:
        ensure_tls(cert, key)
        for path in (cert, key):
            os.chown(path, uid, gid)
        os.chmod(key, 0o600)
        os.chmod(cert, 0o644)

    sway_text = SWAY_TEMPLATE.format(
        script=SCRIPT_NAME, width=WIDTH, height=HEIGHT
    )
    vnc_text = (
        WAYVNC_OPEN_TEMPLATE.format(script=SCRIPT_NAME, port=PORT)
        if args.no_auth
        else WAYVNC_AUTH_TEMPLATE.format(
            script=SCRIPT_NAME, port=PORT, key=key, cert=cert
        )
    )
    write_if_missing(sway_conf, sway_text, uid, gid)
    if args.no_auth and os.path.exists(vnc_conf):
        with open(vnc_conf, "w", encoding="utf-8") as fh:
            fh.write(vnc_text)
        os.chown(vnc_conf, uid, gid)
        log(f"rewrote {vnc_conf} without authentication")
    else:
        write_if_missing(vnc_conf, vnc_text, uid, gid)

    write_unit(unit, uid, gid)

    log(f"enabling linger for {args.user}")
    subprocess.run(["loginctl", "enable-linger", args.user], check=True)

    runtime = wait_for_user_manager(uid)

    def as_user(*cmd: str) -> subprocess.CompletedProcess:
        return subprocess.run(
            [
                runuser, "-u", args.user, "--", "env",
                f"XDG_RUNTIME_DIR={runtime}",
                f"DBUS_SESSION_BUS_ADDRESS=unix:path={runtime}/bus",
                *cmd,
            ]
        )

    if as_user("systemctl", "--user", "daemon-reload").returncode != 0:
        die("systemctl --user daemon-reload failed")
    result = as_user("systemctl", "--user", "enable", SERVICE_NAME)
    if result.returncode == 0:
        result = as_user("systemctl", "--user", "restart", SERVICE_NAME)
    if result.returncode != 0:
        die(f"failed to enable {SERVICE_NAME}")

    active = as_user("systemctl", "--user", "is-active", "--quiet", SERVICE_NAME)
    if active.returncode == 0:
        log(f"service {SERVICE_NAME} is active")
    else:
        log(f"warning: {SERVICE_NAME} did not stay active; check:")
        log(f"  journalctl --user -u {SERVICE_NAME}")
        log(f"  {LOG_FILE}")

    log("")
    log(f"connect to:  <host>:{PORT}  as user {args.user} (PAM password)"
        if not args.no_auth else
        f"connect to:  <host>:{PORT}  (no authentication)")
    log(f"start apps:  {SCRIPT_NAME} run <command>")
    log(f"logs:        {LOG_FILE}")


def _socket_snapshot(runtime: str) -> dict[str, int]:
    """Inode per Wayland socket, so a recreated socket of the same name counts."""
    snapshot: dict[str, int] = {}
    try:
        entries = os.listdir(runtime)
    except OSError:
        return snapshot
    for name in entries:
        if not name.startswith("wayland-") or name.endswith(".lock"):
            continue
        if not name[len("wayland-"):].isdigit():
            continue
        try:
            info = os.stat(os.path.join(runtime, name))
        except OSError:
            continue
        if stat.S_ISSOCK(info.st_mode):
            snapshot[name] = info.st_ino
    return snapshot


def _wait_for_socket(runtime: str, before: dict[str, int],
                     proc: subprocess.Popen) -> str:
    deadline = time.time() + 15.0
    while time.time() < deadline:
        if proc.poll() is not None:
            die(f"sway exited with status {proc.returncode} before creating a socket")
        for name, inode in _socket_snapshot(runtime).items():
            if before.get(name) != inode:
                return name
        time.sleep(0.1)
    die("sway did not create a Wayland socket within 15 s")


def cmd_serve(_: argparse.Namespace) -> None:
    if os.geteuid() == 0:
        die("serve must run as the service user, not root")

    sway = shutil.which("sway")
    wayvnc = shutil.which("wayvnc")
    if not sway:
        die("sway not found")
    if not wayvnc:
        die("wayvnc not found")

    conf_dir = kiosk_dir()
    sway_conf = os.path.join(conf_dir, "sway.conf")
    vnc_conf = os.path.join(conf_dir, "wayvnc.conf")
    log_file = os.environ.get("V2N_KIOSK_LOG") or LOG_FILE

    os.makedirs(conf_dir, exist_ok=True)
    os.chmod(conf_dir, 0o700)

    if not os.path.exists(sway_conf):
        with open(sway_conf, "w", encoding="utf-8") as fh:
            fh.write(SWAY_TEMPLATE.format(
                script=SCRIPT_NAME, width=WIDTH, height=HEIGHT
            ))
        log(f"wrote {sway_conf}")
    if not os.path.exists(vnc_conf):
        cert = os.path.join(conf_dir, "vnc-cert.pem")
        key = os.path.join(conf_dir, "vnc-key.pem")
        ensure_tls(cert, key)
        with open(vnc_conf, "w", encoding="utf-8") as fh:
            fh.write(WAYVNC_AUTH_TEMPLATE.format(
                script=SCRIPT_NAME, port=PORT, key=key, cert=cert
            ))
        os.chmod(vnc_conf, 0o600)
        log(f"wrote {vnc_conf}")

    runtime = runtime_dir()
    alias = os.path.join(runtime, SOCKET)
    if os.path.islink(alias) or os.path.exists(alias):
        os.unlink(alias)

    env = os.environ.copy()
    env["XDG_RUNTIME_DIR"] = runtime
    env.setdefault("WLR_BACKENDS", "headless")
    env.setdefault("WLR_RENDERER", "gles2")
    env["WLR_LIBINPUT_NO_DEVICES"] = "1"
    env["WLR_NO_HARDWARE_CURSORS"] = "1"

    known = _socket_snapshot(runtime)
    log(f"starting {SCRIPT_NAME} on {runtime} ({WIDTH}x{HEIGHT}, "
        f"{env['WLR_RENDERER']} renderer)")
    compositor = subprocess.Popen([sway, "-c", sway_conf], env=env)
    server = None

    def terminate_all() -> None:
        for proc in (server, compositor):
            if proc is not None and proc.poll() is None:
                proc.terminate()
        for proc in (server, compositor):
            if proc is None:
                continue
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()

    def on_signal(*_args: object) -> None:
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    try:
        name = _wait_for_socket(runtime, known, compositor)
        os.symlink(name, alias)
        log(f"Wayland socket {name}, published as {SOCKET}")

        env["WAYLAND_DISPLAY"] = SOCKET
        server = subprocess.Popen([wayvnc, "-C", vnc_conf], env=env)

        while True:
            for proc, label in ((compositor, "sway"), (server, "wayvnc")):
                code = proc.poll()
                if code is not None:
                    log(f"{label} exited with status {code}")
                    raise SystemExit(code or 1)
            time.sleep(0.3)
    finally:
        terminate_all()
        if os.path.islink(alias):
            os.unlink(alias)


def cmd_run(args: argparse.Namespace) -> None:
    if os.geteuid() == 0:
        die("run must be executed as the service user, not root")

    argv = list(args.argv)
    if argv and argv[0] == "--":
        argv = argv[1:]
    if not argv:
        die("run requires a command, e.g.: sway-vnc-kiosk run -- ./game")

    runtime = runtime_dir()
    sock_path = os.path.join(runtime, SOCKET)
    if not os.path.exists(sock_path):
        die(
            f"compositor socket not found: {sock_path}\n"
            f"is the service running?  systemctl --user status {SERVICE_NAME}"
        )

    if "/" in argv[0]:
        exe = argv[0]
        if not os.path.exists(exe):
            print(f"error: command not found: {argv[0]}", file=sys.stderr)
            raise SystemExit(127)
    else:
        exe = shutil.which(argv[0])
        if not exe:
            print(f"error: command not found: {argv[0]}", file=sys.stderr)
            raise SystemExit(127)

    env = os.environ.copy()
    env["XDG_RUNTIME_DIR"] = runtime
    env["WAYLAND_DISPLAY"] = SOCKET
    os.execvpe(exe, [exe, *argv[1:]], env)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=SCRIPT_NAME,
        description="Sway VNC kiosk (640x480, GPU-composited) for headless boards.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            f"  sudo {SCRIPT_NAME} install --user bachnx\n"
            f"  sudo {SCRIPT_NAME} install --user bachnx --no-auth\n"
            f"  {SCRIPT_NAME} serve\n"
            f"  {SCRIPT_NAME} run -- v2n-arm ~/vita-games/PCSE00747/eboot.bin\n"
        ),
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_install = sub.add_parser(
        "install", help="install for a user (must be run as root)"
    )
    p_install.add_argument("--user", required=True, metavar="NAME",
                           help="target user (must exist)")
    p_install.add_argument("--no-auth", action="store_true",
                           help="serve VNC without TLS or authentication")
    p_install.set_defaults(func=cmd_install)

    p_serve = sub.add_parser("serve", help="run the compositor and VNC server")
    p_serve.set_defaults(func=cmd_serve)

    p_run = sub.add_parser(
        "run", help="run a Wayland client against the kiosk socket"
    )
    p_run.add_argument("argv", nargs=argparse.REMAINDER, metavar="COMMAND",
                       help="command and arguments (use -- before flags)")
    p_run.set_defaults(func=cmd_run)

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
