#!/bin/sh
# TigerVNC xstartup for the Orange Pi Zero 3 test bed.
#
# There is no desktop environment: the VNC session runs the game directly.
# Edit ~/.vnc/v2n.conf for paths and debug knobs; this file should rarely
# change. The VNC screen geometry still comes from ~/.vnc/config.

unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS

V2N_CONF=${V2N_CONF:-$HOME/.vnc/v2n.conf}
[ -r "$V2N_CONF" ] && . "$V2N_CONF"

# Match the SDL window to the VNC geometry unless v2n.conf overrides it.
VNC_GEOMETRY=
if [ -r "$HOME/.vnc/config" ]; then
    VNC_GEOMETRY=$(sed -n 's/^geometry=//p' "$HOME/.vnc/config" | head -n 1)
fi

: "${V2N_STATE_DIR:=$HOME/v2n-run}"
: "${V2N_BIN:=$V2N_STATE_DIR/v2n-arm}"
: "${V2N_APP:?V2N_APP is not set; point it at the title's eboot.bin in $V2N_CONF}"
: "${V2N_LOG:=$V2N_STATE_DIR/vnc-game.log}"
: "${V2N_WINDOW_SIZE:=${VNC_GEOMETRY:-960x544}}"
: "${V2N_RENDER_SCALE:=1}"
: "${V2N_FINISH_PER_FRAME:=1}"
: "${V2N_FPS:=0}"
: "${V2N_FPS_OVERLAY:=0}"
: "${V2N_NGS_DEBUG:=0}"
: "${V2N_AUDIO_DEBUG:=0}"
: "${V2N_PROFILE:=0}"
: "${V2N_PROFILE_FRAME:=0}"
: "${V2N_INPUT_DEBUG:=0}"
: "${V2N_TRACE_TEXTURES:=0}"
: "${V2N_CRASH_CORE:=0}"
: "${V2N_XDG_RUNTIME_DIR:=/run/user/1001}"
: "${V2N_PULSE_SERVER:=unix:$V2N_XDG_RUNTIME_DIR/pulse/native}"
: "${V2N_LD_LIBRARY_PATH:=/usr/lib/arm-linux-gnueabihf}"

export EGL_PLATFORM=surfaceless
export SDL_VIDEODRIVER=x11
export SDL_RENDER_DRIVER=software
export VITA2NATIVE_SDL_WINDOWED=1
export VITA2NATIVE_SDL_SIZE="$V2N_WINDOW_SIZE"
export VITA2NATIVE_RENDER_SCALE="$V2N_RENDER_SCALE"
export LD_LIBRARY_PATH="$V2N_LD_LIBRARY_PATH"
export XDG_RUNTIME_DIR="$V2N_XDG_RUNTIME_DIR"
export PULSE_SERVER="$V2N_PULSE_SERVER"

[ "$V2N_FINISH_PER_FRAME" = 1 ] && export VITA2NATIVE_FINISH_PER_FRAME=1
[ "$V2N_FPS" = 1 ] && export VITA2NATIVE_FPS=1
[ "$V2N_FPS_OVERLAY" = 1 ] && export VITA2NATIVE_FPS_OVERLAY=1
[ "$V2N_NGS_DEBUG" = 1 ] && export VITA2NATIVE_NGS_DEBUG=1
[ "$V2N_AUDIO_DEBUG" = 1 ] && export VITA2NATIVE_AUDIO_DEBUG=1
[ "$V2N_PROFILE" = 1 ] && export VITA2NATIVE_PROFILE=1
[ "$V2N_PROFILE_FRAME" = 1 ] && export VITA2NATIVE_PROFILE_FRAME=1
[ "$V2N_INPUT_DEBUG" = 1 ] && export VITA2NATIVE_INPUT_DEBUG=1
[ "$V2N_TRACE_TEXTURES" = 1 ] && export VITA2NATIVE_TRACE_TEXTURES=1

# A crash is only useful if it leaves evidence: the kiosk restarts within a
# couple of seconds and truncates V2N_LOG. Keep the log (and the core, when
# V2N_CRASH_CORE is on) under a timestamped name before the session exits.
if [ "$V2N_CRASH_CORE" = 1 ]; then
    ulimit -c unlimited 2>/dev/null
    export VITA2NATIVE_CRASH_CORE=1
fi

cd "$V2N_STATE_DIR" || exit 1

game_name=$(basename "$V2N_BIN")

# Sweep up a game left behind by a previous session. logind only creates the
# PAM session scope this shell runs in; it is not part of the unit's control
# group, and Ubuntu ships KillUserProcesses=no, so stopping the kiosk leaves
# the child running. Two or three of them saturate this board's four cores and
# starve the new instance, which looks exactly like a hung title.
for pid in $(pgrep -x "$game_name" 2>/dev/null); do
    kill -TERM "$pid" 2>/dev/null
done
sleep 1
pkill -KILL -x "$game_name" 2>/dev/null

# The kiosk restarts the whole session to stop the game, so the child has to
# follow its shell. SDL turns SIGTERM into an SDL_QUIT event, so a guest that
# is busy rendering and not polling events ignores it; escalate to SIGKILL.
stopping=0
stop_game() {
    stopping=1
    kill -TERM "$game_pid" 2>/dev/null
    n=0
    while kill -0 "$game_pid" 2>/dev/null && [ "$n" -lt 15 ]; do
        sleep 0.2
        n=$((n + 1))
    done
    kill -KILL "$game_pid" 2>/dev/null
}

setarch armv7l -R "$V2N_BIN" "$V2N_APP" > "$V2N_LOG" 2>&1 &
game_pid=$!
trap stop_game HUP INT TERM

# Stopping the unit signals Xtigervnc, not this shell, so also watch the
# display: when it goes away the session is over and the game has to follow.
(
    misses=0
    while kill -0 "$game_pid" 2>/dev/null; do
        if xdpyinfo >/dev/null 2>&1; then
            misses=0
        else
            misses=$((misses + 1))
            if [ "$misses" -ge 2 ]; then
                stop_game
                exit 0
            fi
        fi
        sleep 2
    done
) &

wait "$game_pid"
status=$?
trap - HUP INT TERM

# Keep the log only when it holds crash evidence and the X server is still
# alive. Stopping the kiosk kills the X server first, so the game's exit (and
# any Mono thread that faults during teardown) is a shutdown consequence.
if [ "$stopping" -eq 0 ] && [ "$status" -ne 0 ] &&
   grep -q -e "vita2native: guest signal" -e "sceKernelCallAbortHandler called" \
        "$V2N_LOG" 2>/dev/null &&
   xdpyinfo >/dev/null 2>&1; then
    stamp=$(date +%Y%m%d-%H%M%S)
    cp "$V2N_LOG" "$V2N_STATE_DIR/crash-$stamp-$status.log" 2>/dev/null
    [ -f core ] && mv core "core-$stamp" 2>/dev/null
fi
exit "$status"
